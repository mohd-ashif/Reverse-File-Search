# Compose-level variables (used by docker-compose.yml / docker-compose.prod.yml).
# Copy to `.env` at the project root: cp .env.example .env

# Strong password for the Postgres container. Generate with e.g.
# `openssl rand -base64 32`.
POSTGRES_PASSWORD=change-me

# Production only (docker-compose.prod.yml): the public domain Caddy will
# request a TLS certificate for and route to the frontend.
DOMAIN=example.com

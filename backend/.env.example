ENVIRONMENT=development
# ENVIRONMENT=production   # required in production: enables the refresh-cookie
                           # Secure flag and HSTS (see app/auth/middleware.py)
DEBUG=true
# DEBUG=false              # required in production: disables tracebacks in error responses

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reverse_file_search

STORAGE_DIR=./storage
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=file_chunks


EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE_WORDS=500


CHUNK_OVERLAP_WORDS=50

# Leave blank to use tesseract from PATH, or set an absolute path to the executable

TESSERACT_CMD=

# Groq Cloud (https://console.groq.com) — used to synthesize a natural-language
# answer from search results. Leave blank to disable AI answers.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS origins the frontend is served from. In production this must be the
# real public origin(s) (scheme + host + port), not localhost.
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# JWT (RS256 keypair). Generate with: python backend/scripts/generate_jwt_keys.py
# In Docker these paths must point at a volume-mounted directory (see
# docker-compose.yml's backend/keys mount) - if this directory is lost, every
# user's session is invalidated.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth

# SMTP / email (used for verification and password-reset emails)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Reverse File Search
SMTP_USE_TLS=true
SMTP_VALIDATE_CERTS=true

# Base URL of the deployed frontend - used to build the links inside
# verification/password-reset emails. Must be the real production URL,
# otherwise those emails link back to localhost.
FRONTEND_BASE_URL=http://localhost:5173

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
